// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- MODUL PENGGUNA ---
model Pengguna {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  passwordHash  String    @map("password_hash")
  peran         String    // Admin, Kepala Desa, Kasi Pemerintahan
  namaPetugas   String    @map("nama_petugas")
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("pengguna")
}

// --- MODUL KEPENDUDUKAN ---
model Keluarga {
  noKk               String     @id @map("no_kk") @db.VarChar(16)
  kepalaKeluargaNik  String     @map("kepala_keluarga_nik") @db.VarChar(16)
  alamat             String?    @db.Text
  dusun              String?    @db.VarChar(50)
  rt                 String?    @db.VarChar(3)
  rw                 String?    @db.VarChar(3)
  kodePos            String?    @map("kode_pos") @db.VarChar(10)
  kecamatan          String?    @db.VarChar(100)
  kabupaten          String?    @db.VarChar(100)
  provinsi           String?    @db.VarChar(100)
  fotoKk             String?    @map("foto_kk") @db.Text
  tanggalDiterbitkan String?    @map("tanggal_diterbitkan") @db.VarChar(20)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  penduduk           Penduduk[]

  @@map("keluarga")
}

model Penduduk {
  nik                 String         @id @db.VarChar(16)
  noKk                String         @map("no_kk") @db.VarChar(16)
  namaLengkap         String         @map("nama_lengkap") @db.VarChar(150)
  tempatLahir         String?        @map("tempat_lahir") @db.VarChar(100)
  tanggalLahir        DateTime?      @map("tanggal_lahir")
  jenisKelamin        String?        @map("jenis_kelamin") @db.VarChar(1)
  agama               String?        @db.VarChar(20)
  pendidikanTerakhir  String?        @map("pendidikan_terakhir") @db.VarChar(100)
  pekerjaan           String?        @db.VarChar(100)
  statusPerkawinan    String?        @map("status_perkawinan") @db.VarChar(50)
  statusDalamKeluarga String?        @map("status_dalam_keluarga") @db.VarChar(50)
  golonganDarah       String?        @map("golongan_darah") @db.VarChar(20)
  namaAyah            String?        @map("nama_ayah") @db.VarChar(150)
  namaIbu             String?        @map("nama_ibu") @db.VarChar(150)
  kewarganegaraan     String?        @default("WNI") @db.VarChar(50)
  foto                String?        @db.Text
  isHidup             Boolean        @default(true) @map("is_hidup")
  statusDasar         String?        @default("Hidup") @map("status_dasar") @db.VarChar(30)
  statusRekam         String?        @default("BELUM REKAM") @map("status_rekam") @db.VarChar(50)
  noPaspor            String?        @default("") @map("no_paspor") @db.VarChar(30)
  noKitas             String?        @default("") @map("no_kitas") @db.VarChar(30)
  pinHash             String?        @map("pin_hash") @db.VarChar(255)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  keluarga            Keluarga       @relation(fields: [noKk], references: [noKk])
  riwayatSurat        RiwayatSurat[]
  mutasi              Mutasi[]
  permohonanSurat     PermohonanSurat[]

  @@map("penduduk")
}

// --- MODUL MUTASI ---
model Mutasi {
  id              Int       @id @default(autoincrement())
  nik             String    @db.VarChar(16)
  jenisMutasi     String    @map("jenis_mutasi") @db.VarChar(50)
  tanggalMutasi   DateTime  @map("tanggal_mutasi")
  keterangan      String?   @db.Text
  petugasInput    String?   @map("petugas_input") @db.VarChar(100)
  nikKepalaLama   String?   @map("nik_kepala_lama") @db.VarChar(16)

  // Alamat Asal (Pindah Masuk)
  alamatAsal      String?   @map("alamat_asal") @db.Text
  desaAsal        String?   @map("desa_asal") @db.VarChar(100)
  kecamatanAsal   String?   @map("kecamatan_asal") @db.VarChar(100)
  kabupatenAsal   String?   @map("kabupaten_asal") @db.VarChar(100)
  provinsiAsal    String?   @map("provinsi_asal") @db.VarChar(100)
  kodePosAsal     String?   @map("kode_pos_asal") @db.VarChar(10)

  // Alamat Tujuan (Pindah Keluar)
  alamatTujuan    String?   @map("alamat_tujuan") @db.Text
  desaTujuan      String?   @map("desa_tujuan") @db.VarChar(100)
  kecamatanTujuan String?   @map("kecamatan_tujuan") @db.VarChar(100)
  kabupatenTujuan String?   @map("kabupaten_tujuan") @db.VarChar(100)
  provinsiTujuan  String?   @map("provinsi_tujuan") @db.VarChar(100)
  kodePosTujuan   String?   @map("kode_pos_tujuan") @db.VarChar(10)

  createdAt       DateTime  @default(now()) @map("created_at")

  penduduk        Penduduk  @relation(fields: [nik], references: [nik])

  @@map("mutasi")
}

// --- MODUL PERSURATAN ---
model KlasifikasiSurat {
  id          Int           @id @default(autoincrement())
  kode        String        @unique @db.VarChar(20)
  nama        String        @db.VarChar(200)
  masterSurat MasterSurat[]
  suratMasuk  SuratMasuk[]

  @@map("klasifikasi_surat")
}

model MasterSurat {
  id              Int              @id @default(autoincrement())
  kodeSurat       String           @unique @map("kode_surat") @db.VarChar(20)
  namaSurat       String           @map("nama_surat") @db.VarChar(200)
  klasifikasiId   Int              @map("klasifikasi_id")
  formatNomor     String           @map("format_nomor") @db.VarChar(200)
  formSchema      String           @map("form_schema") @db.LongText
  templateContent String?          @map("template_content") @db.LongText
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")

  klasifikasi     KlasifikasiSurat @relation(fields: [klasifikasiId], references: [id])
  riwayatSurat    RiwayatSurat[]
  permohonanSurat PermohonanSurat[]

  @@map("master_surat")
}

model RiwayatSurat {
  id            String      @id @default(cuid())
  nikPemohon    String      @map("nik_pemohon") @db.VarChar(16)
  masterSuratId Int         @map("master_surat_id")
  nomorSurat    String      @map("nomor_surat") @db.VarChar(200)
  tanggalSurat  DateTime    @default(now()) @map("tanggal_surat")
  statusSurat   String      @default("Pending") @map("status_surat") @db.VarChar(30)
  keterangan    String?     @db.Text
  metaData      String      @map("meta_data") @db.LongText
  qrCodeData    String?     @map("qr_code_data") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  penduduk      Penduduk    @relation(fields: [nikPemohon], references: [nik])
  masterSurat   MasterSurat @relation(fields: [masterSuratId], references: [id])

  @@map("riwayat_surat")
}

// --- MODUL PROFIL & PENGATURAN ---
model ProfilDesa {
  id             Int     @id @default(1)
  namaDesa       String  @map("nama_desa") @db.VarChar(100)
  kodeDesa       String? @map("kode_desa") @db.VarChar(50)
  kecamatan      String? @db.VarChar(100)
  kabupaten      String? @db.VarChar(100)
  provinsi       String? @db.VarChar(100)
  alamat         String? @db.Text
  kodePos        String? @map("kode_pos") @db.VarChar(10)
  telepon        String? @db.VarChar(20)
  email          String? @db.VarChar(100)
  website        String? @db.VarChar(100)
  sejarah        String? @db.LongText
  visi           String? @db.Text
  misi           String? @db.Text
  instagram      String? @db.VarChar(100)
  facebook       String? @db.VarChar(100)
  namaKepalaDesa String? @map("nama_kepala_desa") @db.VarChar(150)
  nipKepalaDesa  String? @map("nip_kepala_desa") @db.VarChar(30)
  logoDesa       String? @map("logo_desa") @db.Text
  
  // Layout Settings
  heroTitle      String? @map("hero_title") @db.VarChar(200)
  heroSubtitle   String? @map("hero_subtitle") @db.Text
  welcomeTitle   String? @map("welcome_title") @db.VarChar(200)
  welcomeMessage String? @map("welcome_message") @db.LongText
  heroImage      String? @map("hero_image") @db.Text
  welcomeImage   String? @map("welcome_image") @db.Text

  // User Requested Features
  runningText    String? @map("running_text") @db.Text
  sliderImages   String? @map("slider_images") @db.LongText

  @@map("profil_desa")
}

// --- MODUL ORGANISASI ---
model Jabatan {
  id            Int             @id @default(autoincrement())
  namaJabatan   String          @map("nama_jabatan") @db.VarChar(100)
  kategori      String          @db.VarChar(50) // PEMERINTAH, BPD, LSM, PKK
  level         Int             @default(1)
  urutan        Int             @default(1)
  parentId      Int?            @map("parent_id")
  
  perangkatDesa PerangkatDesa[]

  @@map("jabatan")
}

model PerangkatDesa {
  id                Int      @id @default(autoincrement())
  jabatanId         Int      @map("jabatan_id")
  nik               String   @db.VarChar(16)
  nama              String?  @db.VarChar(150)
  fotoProfil        String?  @map("foto_profil") @db.Text
  tandaTanganDigital String? @map("tanda_tangan_digital") @db.Text
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  jabatan           Jabatan  @relation(fields: [jabatanId], references: [id])

  @@map("perangkat_desa")
}

// --- MODUL TRANSPARANSI & APBDES ---
enum ApbdesJenis {
  PENDAPATAN
  BELANJA
  PEMBIAYAAN
}

model ApbdesKategori {
  id           Int           @id @default(autoincrement())
  namaKategori String        @map("nama_kategori") @db.VarChar(150)
  jenis        ApbdesJenis
  items        ApbdesItem[]

  @@map("apbdes_kategori")
}

model ApbdesItem {
  id           Int            @id @default(autoincrement())
  tahun        Int
  status       String         @default("MURNI") @db.VarChar(50)
  kategoriId   Int            @map("kategori_id")
  namaItem     String         @map("nama_item") @db.VarChar(200)
  anggaran     Decimal        @db.Decimal(15, 2)
  realisasi    Decimal        @default(0) @db.Decimal(15, 2)
  sumberDana   String?        @map("sumber_dana") @db.VarChar(50)
  kodeRekening String?        @map("kode_rekening") @db.VarChar(50)
  keterangan   String?        @db.Text
  
  kategori     ApbdesKategori @relation(fields: [kategoriId], references: [id])

  @@map("apbdes_item")
}

model ProgramKerja {
  id          Int      @id @default(autoincrement())
  tahun       Int
  namaProgram String   @map("nama_program") @db.VarChar(200)
  deskripsi   String?  @db.Text
  lokasi      String?  @db.VarChar(200)
  anggaran    Decimal  @db.Decimal(15, 2)
  sumberDana  String?  @map("sumber_dana") @db.VarChar(100)
  status      String   @default("Rencana") @db.VarChar(50) // Rencana, Berjalan, Selesai
  fotoProgres String?  @map("foto_progres") @db.Text
  latitude    Float?   @db.Double
  longitude   Float?   @db.Double
  gambar      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_kerja")
}

// --- MODUL BERITA ---
model Berita {
  id          Int      @id @default(autoincrement())
  judul       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(191)
  ringkasan   String?  @db.Text
  konten      String   @db.LongText
  gambar      String?  @db.Text
  penulis     String?  @db.VarChar(100)
  tanggal     DateTime @default(now())
  isPublished Boolean  @default(false)
  kategori    String?  @db.VarChar(50)

  @@map("berita")
}

// --- MODUL POTENSI & WISATA ---
model Potensi {
  id          Int      @id @default(autoincrement())
  kategori    String   // WISATA, UMKM
  judul       String   @db.VarChar(200)
  deskripsi   String?  @db.Text
  gambar      String?  @db.Text
  lokasi      String?  @db.VarChar(200)
  harga       String?  @db.VarChar(100)
  isBestSeller Boolean @default(false) @map("is_best_seller")
  mapsUrl     String?  @map("maps_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("potensi_wisata")
}

// --- MODUL PKK & POSYANDU ---
model Posyandu {
  id        Int      @id @default(autoincrement())
  nama      String   @db.VarChar(100)
  dusun     String   @db.VarChar(50)
  
  jadwal    JadwalPosyandu[]
  balita    BalitaKms[]

  @@map("posyandu")
}

model KaderPkk {
  id        Int      @id @default(autoincrement())
  nik       String   @unique @db.VarChar(16)
  nama      String   @db.VarChar(150)
  jabatan   String   @db.VarChar(100)
  areaTugas String   @map("area_tugas") @db.VarChar(100)
  kontak    String?  @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")

  jadwal    JadwalPosyandu[]
  kegiatan  KegiatanPkk[]
  notulenPimpinan  BukuNotulen[] @relation("pimpinan_rapat")
  notulenPembuat   BukuNotulen[] @relation("pembuat_notulen")

  @@map("kader_pkk")
}

model JadwalPosyandu {
  id          Int      @id @default(autoincrement())
  posyanduId  Int      @map("posyandu_id")
  kaderId     Int      @map("kader_id")
  tanggal     DateTime
  waktu       String   @db.VarChar(50)
  sasaran     String   @db.VarChar(100)

  posyandu    Posyandu @relation(fields: [posyanduId], references: [id])
  kader       KaderPkk @relation(fields: [kaderId], references: [id])

  @@map("jadwal_posyandu")
}

model BalitaKms {
  id          Int      @id @default(autoincrement())
  nik         String?  @unique @db.VarChar(16)
  posyanduId  Int      @map("posyandu_id")
  nama        String   @db.VarChar(150)
  namaIbu     String   @map("nama_ibu") @db.VarChar(150)
  jenisKelamin String   @default("L") @map("jenis_kelamin") @db.VarChar(1) // "L" atau "P"
  usiaBulan   Int      @map("usia_bulan")
  beratBadan  Float    @map("berat_badan")
  tinggiBadan Float    @map("tinggi_badan")
  statusGizi  String   @map("status_gizi") @db.VarChar(150)

  posyandu    Posyandu @relation(fields: [posyanduId], references: [id])
  pengukuran  KmsPengukuran[]

  @@map("balita_kms")
}

model KmsPengukuran {
  id          Int      @id @default(autoincrement())
  balitaId    Int      @map("balita_id")
  tanggalUkur DateTime @map("tanggal_ukur")
  usiaBulan   Int      @map("usia_bulan")
  beratBadan  Float    @map("berat_badan")
  tinggiBadan Float    @map("tinggi_badan")
  statusGizi  String   @map("status_gizi") @db.VarChar(150)
  keterangan  String?  @db.Text
  petugas     String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  balita      BalitaKms @relation(fields: [balitaId], references: [id], onDelete: Cascade)

  @@map("kms_pengukuran")
}

model KegiatanPkk {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(150)
  kategori    String   @db.VarChar(50) // "Pokja I", "Pokja II", "Pokja III", "Pokja IV", "Dasawisma"
  subKategori String   @db.VarChar(100) @map("sub_kategori")
  tanggal     DateTime
  lokasi      String   @db.VarChar(150)
  kaderId     Int?     @map("kader_id")
  deskripsi   String?  @db.Text
  dokumentasi String?  @db.Text
  jumlahHadir Int?     @default(0) @map("jumlah_hadir")
  sumberDana  String?  @default("Swadaya") @map("sumber_dana") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  kader       KaderPkk? @relation(fields: [kaderId], references: [id], onDelete: SetNull)

  @@map("kegiatan_pkk")
}

model BukuProgramKerja {
  id                  Int      @id @default(autoincrement())
  pokja               Int      // Pembeda Pokja: 1, 2, 3, 4
  programPokok        String   @map("program_pokok") @db.VarChar(100)
  programPokja        String   @map("program_pokja") @db.VarChar(100)
  kegiatan            String   @db.VarChar(200)
  sasaran             String   @db.VarChar(150)
  lokasi              String   @db.VarChar(150)
  waktuPelaksanaan    String   @map("waktu_pelaksanaan") @db.VarChar(100)
  mitra               String   @db.VarChar(150)
  indikatorKeberhasilan String @map("indikator_keberhasilan") @db.Text
  keterangan          String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("buku_program_kerja")
}

model BukuPelaksanaan {
  id                  Int      @id @default(autoincrement())
  pokja               Int      // Pembeda Pokja: 1, 2, 3, 4
  programPokok        String   @map("program_pokok") @db.VarChar(100)
  programPokja        String   @map("program_pokja") @db.VarChar(100)
  kegiatan            String   @db.VarChar(200)
  tujuanKegiatan      String   @map("tujuan_kegiatan") @db.Text
  sasaran             String   @db.VarChar(150)
  pelaksana           String   @db.VarChar(150)
  waktu               DateTime
  lokasi              String   @db.VarChar(150)
  output              String   @db.Text
  outcome             String   @db.Text
  monitoringEvaluasi  String   @map("monitoring_evaluasi") @db.Text
  keterangan          String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("buku_pelaksanaan")
}

model BukuKegiatan {
  id                  Int      @id @default(autoincrement())
  pokja               Int      // Pembeda Pokja: 1, 2, 3, 4
  nama                String   @db.VarChar(150)
  jabatan             String   @db.VarChar(100)
  tanggal             DateTime
  tempat              String   @db.VarChar(150)
  uraian              String   @db.Text
  keterangan          String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("buku_kegiatan")
}

model BukuNotulen {
  id                  Int      @id @default(autoincrement())
  pokja               Int      // Pembeda Pokja: 1, 2, 3, 4
  tanggal             DateTime
  waktu               String   @db.VarChar(50)
  tempat              String   @db.VarChar(150)
  jenisRapat          String   @map("jenis_rapat") @db.VarChar(100)
  pimpinanRapatId     Int?     @map("pimpinan_rapat_id")
  pembuatNotulenId    Int?     @map("pembuat_notulen_id")
  jumlahDiundang      Int      @map("jumlah_diundang")
  jumlahHadir         Int      @map("jumlah_hadir")
  jumlahTidakHadir    Int      @map("jumlah_tidak_hadir")
  susunanAcara        String   @map("susunan_acara") @db.Text
  kesimpulan          String   @db.Text
  penutup             String   @db.Text
  dokumentasi         String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  pimpinanRapat       KaderPkk? @relation("pimpinan_rapat", fields: [pimpinanRapatId], references: [id], onDelete: SetNull)
  pembuatNotulen      KaderPkk? @relation("pembuat_notulen", fields: [pembuatNotulenId], references: [id], onDelete: SetNull)

  @@map("buku_notulen")
}

// --- MODUL PERSURATAN BARU ---

model SuratMasuk {
  id              Int            @id @default(autoincrement())
  nomorSurat      String         @map("nomor_surat") @db.VarChar(100)
  tanggalSurat    DateTime       @map("tanggal_surat")
  tanggalDiterima DateTime       @default(now()) @map("tanggal_diterima")
  pengirim        String         @db.VarChar(200)
  perihal         String         @db.Text
  klasifikasiId   Int?           @map("klasifikasi_id")
  fileScan        String?        @map("file_scan") @db.Text // URL/Base64 berkas surat
  disposisiKepada String?        @map("disposisi_kepada") @db.VarChar(150) // Perangkat desa yang ditugaskan
  catatanDisposisi String?       @map("catatan_disposisi") @db.Text
  statusDisposisi String         @default("Belum Diproses") @map("status_disposisi") @db.VarChar(50)
  
  klasifikasi     KlasifikasiSurat? @relation(fields: [klasifikasiId], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("surat_masuk")
}

model PermohonanSurat {
  id              String       @id @default(cuid())
  nikPemohon      String       @map("nik_pemohon") @db.VarChar(16)
  masterSuratId   Int          @map("master_surat_id")
  tanggalAjuan    DateTime     @default(now()) @map("tanggal_ajuan")
  status          String       @default("Pending") @map("status_surat") @db.VarChar(30) // Pending, Disetujui, Ditolak
  keteranganBatal String?      @map("keterangan_batal") @db.Text
  keperluan       String       @db.Text
  metaData        String       @map("meta_data") @db.LongText // Data dinamis formulir (JSON)
  
  penduduk        Penduduk     @relation(fields: [nikPemohon], references: [nik])
  masterSurat     MasterSurat  @relation(fields: [masterSuratId], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("permohonan_surat")
}
