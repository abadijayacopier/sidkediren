// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- MODUL PENGGUNA ---
model Pengguna {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  passwordHash  String    @map("password_hash")
  peran         String    // Admin, Kepala Desa, Kasi Pemerintahan
  namaPetugas   String    @map("nama_petugas")
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("pengguna")
}

// --- MODUL KEPENDUDUKAN ---
model Keluarga {
  noKk               String     @id @map("no_kk") @db.VarChar(16)
  kepalaKeluargaNik  String     @map("kepala_keluarga_nik") @db.VarChar(16)
  alamat             String?    @db.Text
  dusun              String?    @db.VarChar(50)
  rt                 String?    @db.VarChar(3)
  rw                 String?    @db.VarChar(3)
  kodePos            String?    @map("kode_pos") @db.VarChar(10)
  tanggalDiterbitkan String?    @map("tanggal_diterbitkan") @db.VarChar(20)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  penduduk           Penduduk[]

  @@map("keluarga")
}

model Penduduk {
  nik                 String         @id @db.VarChar(16)
  noKk                String         @map("no_kk") @db.VarChar(16)
  namaLengkap         String         @map("nama_lengkap") @db.VarChar(150)
  tempatLahir         String?        @map("tempat_lahir") @db.VarChar(100)
  tanggalLahir        DateTime?      @map("tanggal_lahir")
  jenisKelamin        String?        @map("jenis_kelamin") @db.VarChar(1)
  agama               String?        @db.VarChar(20)
  pendidikanTerakhir  String?        @map("pendidikan_terakhir") @db.VarChar(100)
  pekerjaan           String?        @db.VarChar(100)
  statusPerkawinan    String?        @map("status_perkawinan") @db.VarChar(50)
  statusDalamKeluarga String?        @map("status_dalam_keluarga") @db.VarChar(50)
  golonganDarah       String?        @map("golongan_darah") @db.VarChar(20)
  namaAyah            String?        @map("nama_ayah") @db.VarChar(150)
  namaIbu             String?        @map("nama_ibu") @db.VarChar(150)
  kewarganegaraan     String?        @default("WNI") @db.VarChar(50)
  foto                String?        @db.Text
  isHidup             Boolean        @default(true) @map("is_hidup")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  keluarga            Keluarga       @relation(fields: [noKk], references: [noKk])
  riwayatSurat        RiwayatSurat[]

  @@map("penduduk")
}

// --- MODUL PERSURATAN ---
model KlasifikasiSurat {
  id          Int           @id @default(autoincrement())
  kode        String        @unique @db.VarChar(20)
  nama        String        @db.VarChar(200)
  masterSurat MasterSurat[]

  @@map("klasifikasi_surat")
}

model MasterSurat {
  id              Int              @id @default(autoincrement())
  kodeSurat       String           @unique @map("kode_surat") @db.VarChar(20)
  namaSurat       String           @map("nama_surat") @db.VarChar(200)
  klasifikasiId   Int              @map("klasifikasi_id")
  formatNomor     String           @map("format_nomor") @db.VarChar(200)
  formSchema      String           @map("form_schema") @db.LongText
  templateContent String?          @map("template_content") @db.LongText
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")

  klasifikasi     KlasifikasiSurat @relation(fields: [klasifikasiId], references: [id])
  riwayatSurat    RiwayatSurat[]

  @@map("master_surat")
}

model RiwayatSurat {
  id            String      @id @default(cuid())
  nikPemohon    String      @map("nik_pemohon") @db.VarChar(16)
  masterSuratId Int         @map("master_surat_id")
  nomorSurat    String      @map("nomor_surat") @db.VarChar(200)
  tanggalSurat  DateTime    @default(now()) @map("tanggal_surat")
  statusSurat   String      @default("Pending") @map("status_surat") @db.VarChar(30)
  keterangan    String?     @db.Text
  metaData      String      @map("meta_data") @db.LongText
  qrCodeData    String?     @map("qr_code_data") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  penduduk      Penduduk    @relation(fields: [nikPemohon], references: [nik])
  masterSurat   MasterSurat @relation(fields: [masterSuratId], references: [id])

  @@map("riwayat_surat")
}

// --- MODUL PROFIL & PENGATURAN ---
model ProfilDesa {
  id             Int     @id @default(1)
  namaDesa       String  @map("nama_desa") @db.VarChar(100)
  kodeDesa       String? @map("kode_desa") @db.VarChar(50)
  kecamatan      String? @db.VarChar(100)
  kabupaten      String? @db.VarChar(100)
  provinsi       String? @db.VarChar(100)
  alamat         String? @db.Text
  kodePos        String? @map("kode_pos") @db.VarChar(10)
  telepon        String? @db.VarChar(20)
  email          String? @db.VarChar(100)
  website        String? @db.VarChar(100)
  sejarah        String? @db.LongText
  visi           String? @db.Text
  misi           String? @db.Text
  instagram      String? @db.VarChar(100)
  facebook       String? @db.VarChar(100)
  namaKepalaDesa String? @map("nama_kepala_desa") @db.VarChar(150)
  nipKepalaDesa  String? @map("nip_kepala_desa") @db.VarChar(30)
  logoDesa       String? @map("logo_desa") @db.Text
  
  // New Layout Settings
  heroTitle      String? @map("hero_title") @db.VarChar(200)
  heroSubtitle   String? @map("hero_subtitle") @db.Text
  welcomeTitle   String? @map("welcome_title") @db.VarChar(200)
  welcomeMessage String? @map("welcome_message") @db.LongText
  heroImage      String? @map("hero_image") @db.Text
  welcomeImage   String? @map("welcome_image") @db.Text

  // User Requested Features
  runningText    String? @map("running_text") @db.Text
  sliderImages   String? @map("slider_images") @db.LongText

  @@map("profil_desa")
}

// --- MODUL ORGANISASI ---
model Jabatan {
  id            Int             @id @default(autoincrement())
  namaJabatan   String          @map("nama_jabatan") @db.VarChar(100)
  kategori      String          @db.VarChar(50) // PEMERINTAH, BPD, LSM, PKK
  level         Int             @default(1)
  urutan        Int             @default(1)
  parentId      Int?            @map("parent_id")
  
  perangkatDesa PerangkatDesa[]

  @@map("jabatan")
}

model PerangkatDesa {
  id                Int      @id @default(autoincrement())
  jabatanId         Int      @map("jabatan_id")
  nik               String   @db.VarChar(16)
  nama              String?  @db.VarChar(150)
  fotoProfil        String?  @map("foto_profil") @db.Text
  tandaTanganDigital String? @map("tanda_tangan_digital") @db.Text
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  jabatan           Jabatan  @relation(fields: [jabatanId], references: [id])

  @@map("perangkat_desa")
}

// --- MODUL TRANSPARANSI & APBDES ---
enum ApbdesJenis {
  PENDAPATAN
  BELANJA
  PEMBIAYAAN
}

model ApbdesKategori {
  id           Int           @id @default(autoincrement())
  namaKategori String        @map("nama_kategori") @db.VarChar(150)
  jenis        ApbdesJenis
  items        ApbdesItem[]

  @@map("apbdes_kategori")
}

model ApbdesItem {
  id           Int            @id @default(autoincrement())
  tahun        Int
  status       String         @default("MURNI") @db.VarChar(50)
  kategoriId   Int            @map("kategori_id")
  namaItem     String         @map("nama_item") @db.VarChar(200)
  anggaran     Decimal        @db.Decimal(15, 2)
  realisasi    Decimal        @default(0) @db.Decimal(15, 2)
  sumberDana   String?        @map("sumber_dana") @db.VarChar(50)
  kodeRekening String?        @map("kode_rekening") @db.VarChar(50)
  keterangan   String?        @db.Text
  
  kategori     ApbdesKategori @relation(fields: [kategoriId], references: [id])

  @@map("apbdes_item")
}

model ProgramKerja {
  id          Int      @id @default(autoincrement())
  tahun       Int
  namaProgram String   @map("nama_program") @db.VarChar(200)
  deskripsi   String?  @db.Text
  lokasi      String?  @db.VarChar(200)
  anggaran    Decimal  @db.Decimal(15, 2)
  sumberDana  String?  @map("sumber_dana") @db.VarChar(100)
  status      String   @default("Rencana") @db.VarChar(50) // Rencana, Berjalan, Selesai
  fotoProgres String?  @map("foto_progres") @db.Text
  latitude    Float?   @db.Double
  longitude   Float?   @db.Double
  gambar      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_kerja")
}

// --- MODUL BERITA ---
model Berita {
  id          Int      @id @default(autoincrement())
  judul       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(191)
  ringkasan   String?  @db.Text
  konten      String   @db.LongText
  gambar      String?  @db.Text
  penulis     String?  @db.VarChar(100)
  tanggal     DateTime @default(now())
  isPublished Boolean  @default(false)
  kategori    String?  @db.VarChar(50)

  @@map("berita")
}

// --- MODUL POTENSI & WISATA ---
model Potensi {
  id          Int      @id @default(autoincrement())
  kategori    String   // WISATA, UMKM
  judul       String   @db.VarChar(200)
  deskripsi   String?  @db.Text
  gambar      String?  @db.Text
  lokasi      String?  @db.VarChar(200) // Untuk Wisata (misal Dusun Barat)
  harga       String?  @db.VarChar(100) // Untuk UMKM (misal Rp 25.000)
  isBestSeller Boolean @default(false) @map("is_best_seller")
  mapsUrl     String?  @map("maps_url") @db.Text // Link Google Maps untuk Wisata
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("potensi_wisata")
}
